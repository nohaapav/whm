# === Base ===
RPC_BASE=https://mainnet.base.org
CHAIN_ID_BASE=8453
WORMHOLE_ID_BASE=30
# Verified 2026-08-18: chainId() == 30, messageFee() == 0
WORMHOLE_CORE_BASE=0xbebdb6C8ddC678FfA9f8748f85C815C556Dd8ac6

# === Hydration ===
RPC_HYDRATION=https://rpc.hydradx.cloud
CHAIN_ID_HYDRATION=222222
WORMHOLE_ID_HYDRATION=73
# Verified 2026-08-18: chainId() == 73, messageFee() == 0 — generic messaging is live
WORMHOLE_CORE_HYDRATION=0x3792a6d63c31941B2805181771795D9176fA82A1

# === Assets ===
# Native Circle USDC on Base. Verified 2026-08-18: symbol "USDC", name "USD Coin", 6 decimals.
# NOT USDbC (that one is "USD Base Coin").
USDC_BASE=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
# aBasUSDC — verified 2026-08-18 via Pool.getReserveData(USDC).aTokenAddress
AUSDC_BASE=0x4e65fE4DbA92790696d040ac24Aa414708F5c0AB
# Aave v3 PoolAddressesProvider ("Aave V3 BASE Market"); Pool and oracle resolved from it at call
# time. Verified: getPool() = 0xA238Dd80C259a72e81d7e4664a9801593F98d1c5,
#                getPriceOracle() = 0x2Cc0Fc26eD4563A5ce5e8bdcfe1A2878676Ae156
AAVE_ADDRESSES_PROVIDER_BASE=0xe20fCBdBfFC4Dd138cE8b2E6FBb6CB49777ad64D

# HOLLAR — the GHO ERC20 CONTRACT, verified 2026-08-18: 10,719 bytes of code, 5 live facilitators,
# getFacilitatorBucket returns (capacity, level), ERC-1967 impl slot reads zero (not a proxy).
#
# NOT 0x00000000000000000000000000000001000000de. That is the generic Substrate asset precompile
# for HOLLAR (asset id 222). It reports symbol "HOLLAR" and 18 decimals, so it passes a casual
# check, and then reverts "unknown selector" on mint / burn / getFacilitatorBucket. Bound contract
# read from AssetRegistry.AssetLocations(222).
HOLLAR_HYDRATION=0x531a654d1696ed52e7275a8cede955e82620f99a
USDC_DECIMALS=6

# === Roles ===
# Guardian: pauses either leg; cannot move funds out. Held by the same body as the admin on each
# chain — the Hydration Technical Committee and the Base 4-of-7 Safe — so a pause needs the same
# signatures as an upgrade.
FACILITATOR_GUARDIAN=0xaa7e0000000000000000000000000000000aa7e1
VAULT_GUARDIAN=0xD557AeAf1e0cB3D226BfF3B7a10C2cdA9dA081E7
# Treasurer: sweeps surplus (Aave yield + settled fees) above the floor. The Base Safe for now —
# a separate key is not worth managing at this corridor size; the role stays so it can be split later.
VAULT_TREASURER=0xD557AeAf1e0cB3D226BfF3B7a10C2cdA9dA081E7

# === Admin handover ===
# Hydration Technical Committee (EmergencyAdminAccount), per xchain#42.
FACILITATOR_NEW_OWNER=0xaa7e0000000000000000000000000000000aa7e1
# Base technical committee. Gnosis Safe v1.4.1, 4-of-7, verified 2026-08-18; the same signer set
# that already holds BASEJUMP_NEW_OWNER.
#
# Owner decision 2026-08-18: NO upgrade timelock, superseding xchain#42's open "vault upgrade
# timelock length" row. The trade, recorded rather than argued: an upgrade of this contract
# executes as soon as 4 of 7 sign, so a redeemer already in the claim queue has no window to exit
# ahead of it, and the exposure is the whole reserve — which grows as the limits are raised. The
# 4-of-7 threshold is what stands in for the delay.
VAULT_NEW_OWNER=0xD557AeAf1e0cB3D226BfF3B7a10C2cdA9dA081E7

# === Facilitator config ===
# Sized against a 10,000 bucket: the whole corridor may turn over once a day in either
# direction. Zero is closed, not unlimited.
#
# Outbound is NOT set tighter than inbound on purpose. This module is the primary redemption
# route (xchain#41), and a peg defence that throttles the exit harder than the entrance stops
# being one. The bucket already caps mint independently, so inbound is the softer of the two.
#
# Note the real bound is 2x capacity across an arbitrary window: a full bucket spent at the start
# and the refill spent at the end. Size against 20,000, not 10,000, for a single incident.
INBOUND_CAPACITY=10000000000
OUTBOUND_CAPACITY=10000000000
LIMIT_WINDOW=86400

# === Vault config ===
# Mint gate in AaveOracle's 8-dp USD base. $0.99. Refused at init if zero.
MIN_USDC_PRICE=99000000
# 5 bps, a plain admin dial — not tied to the peg band (xchain#41)
REDEEM_FEE_BPS=5
SURPLUS_FLOOR_BPS=25
# OPEN (xchain#42): worst case over any window is capacity, plus one further capacity of burst —
# 20,000 at this 10,000 setting.
#
# With no upgrade timelock this limit and the bucket capacity ARE the loss bound, so raising it
# raises what sits behind a 4-of-7 signature. At this 10,000-scale corridor, Aave's real
# withdrawable liquidity is not the binding constraint: the live Base market (measured 2026-08-18)
# leaves roughly $20.5M withdrawable even at 88.4% utilisation — three orders of magnitude above
# the corridor's own 20,000 burst bound — so redemption timing here is set by DEPOSIT_LIMIT_CAPACITY
# and the facilitator bucket, not by Aave's utilisation the way it would be for a corridor sized
# closer to that liquidity.
DEPOSIT_LIMIT_CAPACITY=10000000000
DEPOSIT_LIMIT_WINDOW=86400
# NOTE: no instant/safe split. Consistency 200 is the chosen level for every message on this
# route — Safe (201) and Finalized (202) are available on both Base's and Hydration's guardian
# sets (wormhole-foundation/wormhole node/pkg/watchers/evm/chain_config.go), not used here by
# design. The residual: a Base reorg landing after a VAA is signed leaves that HOLLAR unbacked,
# bounded by DEPOSIT_LIMIT_CAPACITY above and the facilitator's bucket, not by a slower
# consistency level. Supersedes xchain#40.

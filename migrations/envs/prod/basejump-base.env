# === Base (source) ===
RPC_BASE=https://mainnet.base.org
CHAIN_ID_BASE=8453
WORMHOLE_ID_BASE=30
WORMHOLE_CORE_BASE=0xbebdb6C8ddC678FfA9f8748f85C815C556Dd8ac6

# === Hydration EVM (receiver) ===
# NOTE: must be an EVM JSON-RPC endpoint. https://rpc.hydradx.cloud is the SUBSTRATE
# endpoint and returns HTML here.
RPC_HYDRATION=https://rpc.kril.hydration.cloud
CHAIN_ID_HYDRATION=222222
WORMHOLE_ID_HYDRATION=73
# Wormhole Core on Hydration — verified: chainId()=73, guardian set 7, messageFee()=0
WORMHOLE_CORE_HYDRATION=0x3792a6d63c31941B2805181771795D9176fA82A1

# === Settlement: NTT, Base -> Hydration ===
# Destination chain id is a contract constant (Hydration), not config.
EURC_SOURCE_ASSET=0x60a3E35Cc302bFA44Cb288Bc5a4F316Fdb1adb42
# From hydration-ntt ops/tokens/eurc/deployment.json (Base leg, mode=locking).
# Outbound limit on this leg: 100,000 EURC / 24h sliding window.
EURC_NTT_MANAGER=0xD1dc3517732c98502b5c1ba2389AcA9E9016d89a
# Fee retained by the landing, 6 decimals
EURC_FEE_AMOUNT=100000

# === Landing pool (EXISTING — not deployed by this migration) ===
# The live pool from the MRL deployment's 004-deploy-landing (see
# deployments/archive/basejump-base.json). Already TC-owned and already mapped
# EURC -> asset 44, so this migration only points both ends at it. Steps 002 and 007
# read this one value, which is what makes invariant 1 hold by construction.
HYDRATION_LANDING=0x70e9b12c3b19cb5f0e59984a5866278ab69df976

# === Ownership ===
# Base Technical Committee Safe — Gnosis Safe v1.4.1, 4-of-7.
# Also owns the Base EURC NttManager and its transceiver.
BASE_TC_SAFE=0xD557AeAf1e0cB3D226BfF3B7a10C2cdA9dA081E7
# Hydration Technical Committee (EmergencyAdminAccount).
# Also owns all 11 Hydration NTT managers and the landing above.
RECEIVER_NEW_OWNER=0xaa7e0000000000000000000000000000000aa7e1

# === Legacy deployment (superseded, disarmed separately) ===
# Read by NO step — recorded here so the operator has the disarm target to hand.
# Safe calls setLandingDest(0) on this to close the dead MRL settlement path.
BASEJUMP_BASE_LEGACY=0xf5b9334e44f800382cb47fc19669401d694e529b
# The MRL-era XcmTransactor's Moonbeam MDA (003-deploy-transactor.mdaH160) — that is what
# holds the authorization on the landing, not the transactor proxy. Revoke with
# landing.setAuthorizedBridge(this, false) in the same TC batch as the go-live call.
XCM_TRANSACTOR_MDA_LEGACY=0x10c06f418a082e636ee932ce8f9c5e791b925b51
# First direct (NTT) source, superseded by this migration's fresh deploy — it drops the unused
# tokenBridge slot. Still armed (landingDest + EURC manager set) and deployer-owned, so a call
# would settle gross into the pool with no receiver to pay the sender: disarm with
# setLandingDest(0). Record: deployments/archive/basejump-base-ntt.json.
BASEJUMP_BASE_SUPERSEDED=0x9c007310c2972f656bc4903a16f936fc0cfbc4d2

# HOLLAR — the GHO ERC20 CONTRACT, verified 2026-08-18: 10,719 bytes of code, 5 live facilitators,
# getFacilitatorBucket returns (capacity, level), ERC-1967 impl slot reads zero (not a proxy).
#
# NOT 0x00000000000000000000000000000001000000de. That is the generic Substrate asset precompile
# for HOLLAR (asset id 222). It reports symbol "HOLLAR" and 18 decimals, so it passes a casual
# check, and then reverts "unknown selector" on mint / burn / getFacilitatorBucket. Bound contract
# read from AssetRegistry.AssetLocations(222).
HOLLAR_HYDRATION=0x531a654d1696ed52e7275a8cede955e82620f99a
USDC_DECIMALS=6

# === Roles ===
# Guardian: fast multisig. Pauses either leg; cannot move funds out.
FACILITATOR_GUARDIAN=0x70997970C51812dc3A010C7d01b50e0d17dc79C8
VAULT_GUARDIAN=0x70997970C51812dc3A010C7d01b50e0d17dc79C8
# Treasurer: sweeps surplus, bounded by the floor.
VAULT_TREASURER=0x3C44CdDdB6a900fa2b585dd299e03d12FA4293BC

# === Admin handover ===
# Hydration Technical Committee (EmergencyAdminAccount), per xchain#42.
FACILITATOR_NEW_OWNER=0xaa7e0000000000000000000000000000000aa7e1
# Base technical committee. Gnosis Safe v1.4.1, 4-of-7, verified 2026-08-18; the same signer set
# that already holds BASEJUMP_NEW_OWNER.
#
# Owner decision 2026-08-18: NO upgrade timelock, superseding xchain#42's open "vault upgrade
# timelock length" row. The trade, recorded rather than argued: an upgrade of this contract
# executes as soon as 4 of 7 sign, so a redeemer already in the claim queue has no window to exit
# ahead of it, and the exposure is the whole reserve — which grows as the limits are raised. The
# 4-of-7 threshold is what stands in for the delay.
VAULT_NEW_OWNER=0xD557AeAf1e0cB3D226BfF3B7a10C2cdA9dA081E7

# === Facilitator config ===
# Sized against a 250,000 bucket: the whole corridor may turn over once a day in either
# direction. Zero is closed, not unlimited.
#
# Outbound is NOT set tighter than inbound on purpose. This module is the primary redemption
# route (xchain#41), and a peg defence that throttles the exit harder than the entrance stops
# being one. The bucket already caps mint independently, so inbound is the softer of the two.
#
# Note the real bound is 2x capacity across an arbitrary window: a full bucket spent at the start
# and the refill spent at the end. Size against 500,000, not 250,000, for a single incident.
INBOUND_CAPACITY=250000000000
OUTBOUND_CAPACITY=250000000000
LIMIT_WINDOW=86400

# === Vault config ===
# Mint gate in AaveOracle's 8-dp USD base. $0.99. Refused at init if zero.
MIN_USDC_PRICE=99000000
# 5 bps, a plain admin dial — not tied to the peg band (xchain#41)
REDEEM_FEE_BPS=5
SURPLUS_FLOOR_BPS=25
# OPEN (xchain#42): worst case over any window is capacity, plus one further capacity of burst.
#
# With no upgrade timelock these limits and the bucket capacity ARE the loss bound, so raising
# them raises what sits behind a 4-of-7 signature. Sizing note against the live Base market
# (measured 2026-08-18): $176.6M supplied at 88.4% utilisation leaves ~$20.5M withdrawable, and
# that residual is what redemptions are actually paid from — not the headline supply. Roughly
# $8.8M at 95% utilisation, $1.8M at 99%. Below about $1M outstanding the queue clears regardless
# of Aave's state; past that, redemption timing becomes utilisation-dependent by design.
DEPOSIT_LIMIT_CAPACITY=250000000000
DEPOSIT_LIMIT_WINDOW=86400
# NOTE: no instant/safe split. Consistency 200 is the only level this route can publish at, so
# every message lands immediately and nothing buys extra certainty for a large deposit. The
# residual: a Base reorg landing after a VAA is signed leaves that HOLLAR unbacked, bounded only
# by DEPOSIT_LIMIT_CAPACITY above and the facilitator's bucket. Supersedes xchain#40.

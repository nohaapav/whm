# === Ethereum (anvil fork, sh/fork-ethereum.sh) ===
RPC_ETHEREUM=http://127.0.0.1:8550
CHAIN_ID_ETHEREUM=1
WORMHOLE_ID_ETHEREUM=2
WORMHOLE_CORE_ETHEREUM=0x98f3c9e6E3fAce36bAAd05FE09d375Ef1464288B

# === Settlement: NTT, Ethereum -> Hydration ===
# Destination chain id is a contract constant (Hydration, 73), not config.
USDC_SOURCE_ASSET=0xA0b86991c6218b36c1d19D4a2e9Eb0cE3606eB48
# Ethereum is USDC's NTT hub, so this leg is mode=LOCKING (Base EURC is the same shape).
# Verified on mainnet: token()=USDC, getMode()=0, getPeer(73)=0xEcEab645…28fC (the Hydration
# burning manager), quoteDeliveryPrice(73,0x00)=0.
# Outbound limit on this leg: 100,000 USDC / 24h sliding window.
USDC_NTT_MANAGER=0x447b2c7485A3d6813F8197E605b10BcCD8dd8398
# Fee retained by the landing, 6 decimals. Matches EURC's 0.1 — owner-settable later.
USDC_FEE_AMOUNT=100000

# === Landing pool (EXISTING — not deployed by this migration) ===
# The same live pool basejump-base settles into. TC-owned. Already mapped EURC -> asset 44;
# the USDC -> asset 21 mapping is a TC call, NOT a step here (see below).
HYDRATION_LANDING=0x70e9b12c3b19cb5f0e59984a5866278ab69df976

# === Ownership ===
# Technical Committee Safe — Gnosis Safe v1.4.1, 4-of-7. The Base TC Safe address is deployed at
# the same address on Ethereum mainnet; verified: VERSION()=1.4.1, getThreshold()=4, 7 owners.
ETHEREUM_TC_SAFE=0xD557AeAf1e0cB3D226BfF3B7a10C2cdA9dA081E7

# === TC actions on Hydration (read by NO step — recorded for the operator) ===
# 1. receiver.setAuthorizedEmitter(2, pad(<001-deploy-emitter.proxyAddress>))  ← go-live switch
#    The receiver is deployed by basejump-base step 005; copy it from
#    deployments/prod/basejump-base.json after that migration runs.
BASEJUMP_RECEIVER_HYDRATION=
# 2. landing.setDestAsset(USDC_SOURCE_ASSET, USDC_DEST_ASSET)
#    Hydration USDC, asset 21. Confirmed as the Hydration USDC NttManager's token().
USDC_DEST_ASSET=0x0000000000000000000000000000000100000015
#    Both calls: contracts/scripts/basejump-landing/addRoute.ts prints the calldata.
# 3. Fund the pool with asset 21 — it currently holds EURC only.
